.type-research
  .layout.hide-aside
    max-width: 1600px

  #page.nc
    padding: 0 28px

    +maxWidth600()
      padding: 0 16px

  .page-title
    text-align: center

.research-container
  margin-bottom: 24px

.research-chart-section
  margin-top: 18px

  &:first-of-type
    margin-top: 18px

.research-progress-card
  margin-bottom: 14px
  padding: 18px 22px
  background: var(--card-bg)
  border-radius: 8px
  box-shadow: var(--card-box-shadow)

  +maxWidth600()
    padding: 16px 18px

.research-progress-header
  display: flex
  align-items: center
  justify-content: space-between
  flex-wrap: wrap
  gap: 6px 16px

  .research-progress-count
    flex: none
    color: var(--card-meta)
    font-size: .84em
    font-variant-numeric: tabular-nums

.research-progress
  overflow: hidden
  height: 8px
  margin-top: 14px
  border-radius: 999px
  background: var(--light-grey)

  span
    display: block
    width: 0
    height: 100%
    border-radius: inherit
    background: #3573c9
    transition: width .3s ease

  .plan-project &
    span
      background: #2f9e6f

  .plan-mciaa &
    span
      background: #8a5fd3

.research-progress-footer
  display: flex
  align-items: center
  justify-content: space-between
  gap: 14px
  margin-top: 10px
  color: var(--card-meta)
  font-size: .8em
  line-height: 1.5

  span
    min-width: 0

.research-progress-link
  display: inline-flex
  flex: none
  align-items: center
  gap: 6px
  color: var(--btn-bg)
  font-weight: 600
  text-decoration: none

// ==================== 文献卡片墙(热门文章页同款网格卡片,按时间排序) ====================
.research-card-wall
  background: var(--card-bg)
  border-radius: 8px
  box-shadow: var(--card-box-shadow)
  padding: 20px 22px

  +maxWidth600()
    padding: 14px 14px 16px

.research-card-grid
  display: grid
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr))
  gap: 18px

  +maxWidth600()
    grid-template-columns: 1fr
    gap: 14px

.research-card
  display: flex
  flex-direction: column
  overflow: hidden
  border-radius: 14px
  background: var(--card-bg)
  box-shadow: 0 4px 16px rgba(0, 0, 0, .1), 0 0 0 1px rgba(0, 0, 0, .04)
  color: var(--font-color)
  text-decoration: none
  transition: transform .25s ease, box-shadow .25s ease

  &:hover
    transform: translateY(-4px)
    box-shadow: 0 10px 26px rgba(0, 0, 0, .14), 0 0 0 1px rgba(0, 0, 0, .04)

    .research-card-title
      color: var(--btn-bg)

    .research-card-cover img
      transform: scale(1.06)

    .research-card-arrow i
      color: var(--btn-bg)
      transform: rotate(-45deg) translate(2px, -2px)

  &:focus-visible
    outline: 2px solid var(--btn-bg)
    outline-offset: 2px

.research-card-cover
  position: relative
  display: block
  height: 150px
  overflow: hidden
  background: var(--light-grey)

  img
    display: block
    width: 100%
    height: 100%
    object-fit: cover
    transition: transform .5s ease

.research-card-body
  flex: 1
  display: flex
  flex-direction: column
  gap: 8px
  min-width: 0
  padding: 13px 15px 12px

.research-card-title
  display: -webkit-box
  overflow: hidden
  -webkit-box-orient: vertical
  -webkit-line-clamp: 2
  color: var(--font-color)
  font-size: 1em
  font-weight: 700
  line-height: 1.45
  transition: color .2s ease
  word-break: break-word

.research-card-meta
  display: flex
  flex-wrap: wrap
  align-items: center
  gap: 6px 8px
  font-size: .76em

.research-card-date
  display: inline-flex
  align-items: center
  gap: 5px
  color: var(--card-meta)
  font-variant-numeric: tabular-nums

.research-card-track
  padding: 1px 9px
  border-radius: 4px
  background: rgba(53, 115, 201, .12)
  color: #3573c9
  font-weight: 600

  &.track-system
    background: rgba(47, 158, 111, .14)
    color: #2f9e6f

  &.track-skill
    background: rgba(185, 138, 47, .14)
    color: #b98a2f

.research-card-status
  padding: 1px 7px
  border-radius: 4px
  color: var(--card-meta)
  background: var(--light-grey)

.research-card-summary
  display: -webkit-box
  margin: 0
  overflow: hidden
  -webkit-box-orient: vertical
  -webkit-line-clamp: 3
  color: var(--card-meta)
  font-size: .84em
  line-height: 1.7

.research-card-foot
  display: flex
  align-items: center
  margin-top: auto
  padding: 9px 15px 12px
  border-top: 1px dashed var(--light-grey)
  color: var(--card-meta)
  font-size: .82em

.research-card-pv
  display: inline-flex
  align-items: center
  gap: 6px
  font-variant-numeric: tabular-nums

  i
    color: #3573c9
    font-size: .95em

.research-card-arrow
  margin-left: auto

  i
    color: var(--card-meta)
    font-size: .9em
    transform: rotate(-45deg)
    transition: color .2s ease, transform .2s ease

// 轨道文字色(阅读曲线 tooltip 的 .research-timeline-track 也复用)
.research-timeline-track
  color: #3573c9
  font-weight: 600

  &.track-system
    color: #2f9e6f

  &.track-skill
    color: #b98a2f

.research-empty
  padding: 40px
  border-radius: 8px
  background: var(--card-bg)
  box-shadow: var(--card-box-shadow)
  color: var(--card-meta)
  text-align: center

[data-theme='dark']
  .research-timeline-track
    color: #6cb6ff

    &.track-system
      color: #4cc38a

    &.track-skill
      color: #d8a94a

  .research-card
    box-shadow: 0 4px 16px rgba(0, 0, 0, .35), 0 0 0 1px rgba(255, 255, 255, .06)

    &:hover
      box-shadow: 0 10px 26px rgba(0, 0, 0, .45), 0 0 0 1px rgba(255, 255, 255, .08)

  .research-card-track
    background: rgba(108, 182, 255, .14)
    color: #6cb6ff

    &.track-system
      background: rgba(76, 195, 138, .14)
      color: #4cc38a

    &.track-skill
      background: rgba(216, 169, 74, .16)
      color: #d8a94a

  .research-card-pv i
    color: #6cb6ff

// ==================== 任务标题切换(进度卡标题栏内) ====================
.research-task-tabs
  display: flex
  flex-wrap: wrap
  align-items: baseline
  gap: 6px 40px
  min-width: 0

  +maxWidth600()
    gap: 4px 22px

.research-task-tab
  display: inline-flex
  align-items: baseline
  gap: 7px
  padding: 2px 1px 8px
  border: none
  border-bottom: 2px solid transparent
  background: none
  color: var(--card-meta)
  font-size: 1.08em
  font-weight: 700
  line-height: 1.4
  cursor: pointer
  transition: color .2s ease, border-color .2s ease

  +maxWidth600()
    gap: 5px
    font-size: .98em

  &:hover
    color: var(--chart-accent)

  &:focus-visible
    outline: 2px solid var(--chart-accent)
    outline-offset: 2px
    border-radius: 4px

  .research-task-tab-count
    color: var(--card-meta)
    font-size: .68em
    font-weight: 500
    font-variant-numeric: tabular-nums

  &.is-active
    border-bottom-color: var(--chart-accent)
    color: var(--font-color)

    .research-task-tab-count
      color: var(--chart-accent)

// 每个任务的主题色(标题 Tab 下划线 / 徽标共用;折线图颜色由 JS 内联注入)
.research-task-tab.plan-literature,
.research-chart-section.plan-literature
  --chart-accent: #3573c9

.research-task-tab.plan-project,
.research-chart-section.plan-project
  --chart-accent: #2f9e6f

.research-task-tab.plan-mciaa,
.research-chart-section.plan-mciaa
  --chart-accent: #8a5fd3

// 切换显隐:只有激活的任务大框可见
.research-chart-section
  display: none

  &.is-active
    display: block
    animation: research-section-in .32s ease

@keyframes research-section-in
  from
    opacity: 0
    transform: translateY(10px)

  to
    opacity: 1
    transform: none

.research-unlimited-chip
  display: inline-block
  vertical-align: 3px
  margin-left: 8px
  padding: 2px 9px
  border-radius: 999px
  background: var(--chart-accent)
  color: #fff
  font-size: .62em
  font-weight: 600
  letter-spacing: .04em

// ==================== 阅读曲线(折线图) ====================
.research-linechart-card
  margin-bottom: 14px
  padding: 16px 20px 12px
  background: var(--card-bg)
  border-radius: 8px
  box-shadow: var(--card-box-shadow)

  +maxWidth600()
    padding: 14px 14px 10px

.research-linechart-header
  display: flex
  align-items: baseline
  justify-content: space-between
  gap: 12px

.research-linechart-title
  display: inline-flex
  align-items: center
  gap: 7px
  color: var(--font-color)
  font-size: .95em

  i
    color: var(--chart-accent)

.research-linechart-subtitle
  color: var(--card-meta)
  font-size: .78em

.research-linechart-body
  position: relative
  margin-top: 8px

  svg
    display: block
    max-width: 100%

.rlc-grid
  stroke: rgba(128, 128, 128, .16)

.rlc-grid-base
  stroke: rgba(128, 128, 128, .34)

.rlc-axis
  fill: var(--card-meta)
  font-size: 11px
  font-variant-numeric: tabular-nums

.rlc-area
  fill: var(--chart-accent)
  opacity: .12

.rlc-line
  fill: none
  stroke: var(--chart-accent)
  stroke-width: 2.5
  stroke-linecap: round
  stroke-linejoin: round

.rlc-target
  stroke: var(--chart-accent)
  stroke-dasharray: 5 5
  opacity: .55

.rlc-target-label
  fill: var(--card-meta)

.rlc-dot
  cursor: pointer

  .rlc-dot-hit
    fill: transparent

  .rlc-dot-core
    fill: var(--card-bg)
    stroke: var(--chart-accent)
    stroke-width: 2.5
    transition: transform .18s ease
    transform-box: fill-box
    transform-origin: center

  &:hover .rlc-dot-core,
  &:focus .rlc-dot-core
    transform: scale(1.45)

  &:focus
    outline: none

    .rlc-dot-core
      stroke-width: 3.5

.rlc-tip
  position: absolute
  left: 0
  top: 0
  z-index: 6
  max-width: 300px
  padding: 10px 13px
  border-radius: 8px
  background: var(--card-bg)
  box-shadow: 0 10px 26px rgba(0, 0, 0, .2), 0 0 0 1px rgba(0, 0, 0, .05)
  opacity: 0
  visibility: hidden
  transition: opacity .16s ease, visibility .16s
  pointer-events: none

  &.is-visible
    opacity: 1
    visibility: visible

  .rlc-tip-meta
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: 8px
    color: var(--card-meta)
    font-size: .74em
    font-variant-numeric: tabular-nums

  .rlc-tip-title
    display: block
    margin-top: 6px
    color: var(--font-color)
    font-size: .84em
    font-weight: 600
    line-height: 1.5
    word-break: break-word

.research-linechart-placeholder
  padding: 38px 10px
  color: var(--card-meta)
  font-size: .84em
  text-align: center

[data-theme='dark']
  .research-task-tab.plan-literature,
  .research-chart-section.plan-literature
    --chart-accent: #6cb6ff

  .research-task-tab.plan-project,
  .research-chart-section.plan-project
    --chart-accent: #4cc38a

  .research-task-tab.plan-mciaa,
  .research-chart-section.plan-mciaa
    --chart-accent: #b79bff

  .rlc-grid
    stroke: rgba(170, 170, 170, .14)

  .rlc-grid-base
    stroke: rgba(170, 170, 170, .3)

  .rlc-tip
    box-shadow: 0 10px 26px rgba(0, 0, 0, .5), 0 0 0 1px rgba(255, 255, 255, .07)

// ============================================================
// ★ starlite 美化层（追加于文件尾部，规则在后优先）
//   无框星空风 · 双模式。做法：
//   1) 覆盖本页 --card-bg 变量 → 所有 var(--card-bg) 表面一次变半透明
//   2) 大容器追加边框 + 磨砂（小卡片不加 blur，避免几十张卡的性能开销）
//   3) 去底板 + 衬线金字页标题
//   轨道/进度条等功能性颜色一律不动
// ============================================================

// 卡面变量切换
.type-research
  --card-bg: rgba(255, 255, 255, .66)

[data-theme="dark"] .type-research
  --card-bg: rgba(20, 20, 31, .72)

// 去底板
.type-research div#page,
[data-theme="dark"] .type-research div#page
  background: transparent !important
  border: none !important
  box-shadow: none !important
  border-radius: 0 !important
  padding: 0 28px !important

  +maxWidth600()
    padding: 0 16px !important

// 主容器：细边框 + 磨砂
.research-container
  .research-progress-card,
  .research-linechart-card,
  .research-card-wall,
  .research-empty
    border: 1px solid rgba(0, 0, 0, .07)
    backdrop-filter: blur(8px)
    -webkit-backdrop-filter: blur(8px)

  .research-card
    border: 1px solid rgba(0, 0, 0, .06)

// 任务 tab 激活金色化
.research-task-tab
  &.is-active
    border-bottom-color: #b99c4d

    .research-task-tab-count
      color: #8a6a26

  &:hover
    color: #8a6a26

[data-theme="dark"] .research-container
  .research-progress-card,
  .research-linechart-card,
  .research-card-wall,
  .research-empty
    border-color: rgba(232, 217, 160, .14)

  .research-card
    border-color: rgba(232, 217, 160, .12)

[data-theme="dark"] .research-task-tab
  &.is-active
    border-bottom-color: #e8d9a0

    .research-task-tab-count
      color: #e8d9a0

  &:hover
    color: #e8d9a0
