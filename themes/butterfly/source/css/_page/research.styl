.type-research
  .layout.hide-aside
    max-width: 1600px

  #page.nc
    padding: 0 28px

    +maxWidth600()
      padding: 0 16px

  .page-title
    text-align: center

.research-container
  margin-bottom: 24px

.research-chart-section
  margin-top: 28px

  &:first-of-type
    margin-top: 20px

.research-progress-card
  margin-bottom: 14px
  padding: 18px 22px
  background: var(--card-bg)
  border-radius: 8px
  box-shadow: var(--card-box-shadow)

  +maxWidth600()
    padding: 16px 18px

.research-progress-header
  display: flex
  align-items: baseline
  justify-content: space-between
  gap: 16px

  h3
    margin: 0
    color: var(--font-color)
    font-size: 1.14em
    line-height: 1.4

  .research-progress-count
    flex: none
    color: var(--card-meta)
    font-size: .84em
    font-variant-numeric: tabular-nums

.research-progress
  overflow: hidden
  height: 8px
  margin-top: 14px
  border-radius: 999px
  background: var(--light-grey)

  span
    display: block
    width: 0
    height: 100%
    border-radius: inherit
    background: #3573c9
    transition: width .3s ease

  .plan-project &
    span
      background: #2f9e6f

.research-progress-footer
  display: flex
  align-items: center
  justify-content: space-between
  gap: 14px
  margin-top: 10px
  color: var(--card-meta)
  font-size: .8em
  line-height: 1.5

  span
    min-width: 0

.research-progress-link
  display: inline-flex
  flex: none
  align-items: center
  gap: 6px
  color: var(--btn-bg)
  font-weight: 600
  text-decoration: none

.research-timeline-chart
  background: var(--card-bg)
  border-radius: 8px
  box-shadow: var(--card-box-shadow)

.research-timeline-viewport
  max-height: 700px
  overflow: auto
  padding: 36px 40px 28px
  scrollbar-width: thin
  scrollbar-color: rgba(128, 128, 128, .35) transparent

  &::-webkit-scrollbar
    width: 5px
    height: 5px

  &::-webkit-scrollbar-track
    background: transparent

  &::-webkit-scrollbar-thumb
    border-radius: 999px
    background: rgba(128, 128, 128, .35)

  &::-webkit-scrollbar-thumb:hover
    background: rgba(128, 128, 128, .55)

  +maxWidth600()
    padding: 24px 16px 20px

.research-timeline-strip
  position: relative
  display: flex
  align-items: stretch
  column-gap: 56px
  min-width: max-content
  padding: 0 12px

  &::before
    content: ''
    position: absolute
    top: 50%
    right: -32px
    left: -32px
    border-top: 2px dashed rgba(53, 115, 201, .38)
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 28px, #000 calc(100% - 28px), transparent)
    mask-image: linear-gradient(90deg, transparent, #000 28px, #000 calc(100% - 28px), transparent)

.research-timeline-item
  position: relative
  display: grid
  flex: none
  grid-template-rows: 1fr auto 1fr
  width: 264px

  +maxWidth600()
    width: 218px

.research-timeline-half
  display: flex
  flex-direction: column
  min-width: 0

  &.is-top
    justify-content: flex-end

  &.is-bottom
    justify-content: flex-start

.research-timeline-connector
  flex: 1
  width: 1px
  min-height: 36px
  margin: 0 auto
  background: rgba(128, 128, 128, .38)

.research-timeline-date
  color: var(--card-meta)
  font-size: .78em
  font-variant-numeric: tabular-nums
  letter-spacing: .02em
  text-align: center

  .is-top &
    padding: 0 0 10px

  .is-bottom &
    padding: 10px 0 0

.research-timeline-dot
  display: flex
  align-items: center
  justify-content: center
  height: 26px

.research-timeline-dot-core
  width: 12px
  height: 12px
  border: 3px solid #3573c9
  border-radius: 50%
  background: var(--card-bg)
  box-shadow: 0 0 0 4px rgba(53, 115, 201, .12)
  transition: transform .2s ease, box-shadow .2s ease

  .is-planned &
    border-style: dashed

  .research-timeline-item:hover &
    transform: scale(1.3)
    box-shadow: 0 0 0 6px rgba(53, 115, 201, .16)

.research-timeline-card
  display: flex
  flex-direction: column
  overflow: hidden
  border-radius: 12px
  background: var(--card-bg)
  box-shadow: 0 4px 16px rgba(0, 0, 0, .1), 0 0 0 1px rgba(0, 0, 0, .04)
  color: var(--font-color)
  text-decoration: none
  transition: transform .25s ease, box-shadow .25s ease

  &:hover
    transform: translateY(-4px)
    box-shadow: 0 10px 26px rgba(0, 0, 0, .14), 0 0 0 1px rgba(0, 0, 0, .04)

  &:focus-visible
    outline: 2px solid var(--btn-bg)
    outline-offset: 2px

.research-timeline-card-cover
  position: relative
  display: block
  aspect-ratio: 16 / 9
  background: var(--light-grey)

  img
    display: block
    width: 100%
    height: 100%
    object-fit: cover

.research-timeline-card-cover-bg
  display: block
  width: 100%
  height: 100%

.research-timeline-card-date
  position: absolute
  bottom: 8px
  left: 8px
  display: inline-flex
  align-items: center
  gap: 5px
  padding: 3px 8px
  border-radius: 6px
  background: rgba(0, 0, 0, .45)
  color: #fff
  font-size: .72em
  font-variant-numeric: tabular-nums
  backdrop-filter: blur(4px)

  i
    font-size: .95em

.research-timeline-card-body
  display: block
  padding: 12px 14px 0

.research-timeline-card-meta
  display: flex
  align-items: center
  gap: 8px
  font-size: .74em

.research-timeline-track
  color: #3573c9
  font-weight: 600

  &.track-system
    color: #2f9e6f

  &.track-skill
    color: #b98a2f

.research-timeline-status
  padding: 1px 7px
  border-radius: 4px
  color: var(--card-meta)
  background: var(--light-grey)

.research-timeline-card-title
  display: -webkit-box
  margin-top: 6px
  overflow: hidden
  -webkit-box-orient: vertical
  -webkit-line-clamp: 2
  color: var(--font-color)
  font-size: .96em
  font-weight: 600
  line-height: 1.45
  transition: color .2s ease
  word-break: break-word

  .research-timeline-card:hover &
    color: var(--btn-bg)

.research-timeline-card-summary
  display: -webkit-box
  margin-top: 6px
  overflow: hidden
  -webkit-box-orient: vertical
  -webkit-line-clamp: 3
  color: var(--card-meta)
  font-size: .82em
  line-height: 1.7

.research-timeline-card-footer
  display: flex
  justify-content: flex-end
  padding: 10px 12px 12px

  i
    color: var(--card-meta)
    font-size: .85em
    transform: rotate(-45deg)
    transition: color .2s ease, transform .2s ease

  .research-timeline-card:hover &
    i
      color: var(--btn-bg)
      transform: rotate(-45deg) translate(2px, -2px)

.research-timeline-popover
  position: fixed
  z-index: 1002
  width: calc(100vw - 24px)
  max-width: 440px
  max-height: 66vh
  overflow-y: auto
  padding: 14px 16px 13px
  border-radius: 10px
  background: var(--card-bg)
  box-shadow: 0 12px 34px rgba(0, 0, 0, .24), 0 0 0 1px rgba(0, 0, 0, .05)
  opacity: 0
  visibility: hidden
  transform: translateY(6px)
  transition: opacity .18s ease, transform .18s ease, visibility .18s
  scrollbar-width: thin
  scrollbar-color: rgba(128, 128, 128, .35) transparent

  &.is-visible
    opacity: 1
    visibility: visible
    transform: translateY(0)

  .research-timeline-popover-meta
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: 8px
    color: var(--card-meta)
    font-size: .78em
    font-variant-numeric: tabular-nums

  .research-timeline-popover-title
    display: block
    margin: 8px 0 6px
    color: var(--font-color)
    font-size: .97em
    font-weight: 600
    line-height: 1.5
    overflow-wrap: break-word

  .research-timeline-popover-summary
    display: block
    margin: 0
    color: var(--card-meta)
    font-size: .84em
    line-height: 1.85
    overflow-wrap: break-word

.research-empty
  padding: 40px
  border-radius: 8px
  background: var(--card-bg)
  box-shadow: var(--card-box-shadow)
  color: var(--card-meta)
  text-align: center

[data-theme='dark']
  .research-timeline-strip
    &::before
      border-top-color: rgba(108, 182, 255, .32)

  .research-timeline-connector
    background: rgba(170, 170, 170, .28)

  .research-timeline-dot-core
    border-color: #6cb6ff
    box-shadow: 0 0 0 4px rgba(108, 182, 255, .14)

    .research-timeline-item:hover &
      box-shadow: 0 0 0 6px rgba(108, 182, 255, .2)

  .is-planned .research-timeline-dot-core
    border-style: dashed

  .research-timeline-track
    color: #6cb6ff

    &.track-system
      color: #4cc38a

    &.track-skill
      color: #d8a94a

  .research-timeline-card
    box-shadow: 0 4px 16px rgba(0, 0, 0, .35), 0 0 0 1px rgba(255, 255, 255, .06)

    &:hover
      box-shadow: 0 10px 26px rgba(0, 0, 0, .45), 0 0 0 1px rgba(255, 255, 255, .08)

    .research-timeline-card-date
      background: rgba(0, 0, 0, .55)

  .research-timeline-popover
    box-shadow: 0 12px 34px rgba(0, 0, 0, .55), 0 0 0 1px rgba(255, 255, 255, .08)
