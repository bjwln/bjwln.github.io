.type-research
  .layout.hide-aside
    max-width: 1600px

  #page.nc
    padding: 0 28px

    +maxWidth600()
      padding: 0 16px

  .page-title
    text-align: center

.research-container
  margin-bottom: 24px

.research-timeline-chart
  display: grid
  grid-template-columns: minmax(0, 1fr) 360px
  align-items: stretch
  overflow: hidden
  background: var(--card-bg)
  border-radius: 8px
  box-shadow: var(--card-box-shadow)

  @media screen and (max-width: 1100px)
    grid-template-columns: 1fr

.research-timeline-viewport
  min-width: 0
  overflow-x: auto
  padding: 28px 28px 24px

  svg
    display: block
    width: 100%
    height: auto

  text
    fill: var(--card-meta)
    font-family: inherit
    font-size: 16px

  @media screen and (max-width: 1100px)
    svg
      min-width: 1080px

  +maxWidth600()
    padding: 16px 14px

.research-timeline-detail
  display: flex
  flex-direction: column
  min-width: 0
  overflow-y: auto
  padding: 28px 26px 24px
  border-left: 1px solid var(--light-grey)

  @media screen and (max-width: 1100px)
    overflow-y: visible
    border-left: none
    border-top: 1px solid var(--light-grey)

  h4
    margin: 14px 0 8px
    color: var(--font-color)
    font-size: 1.18em
    line-height: 1.45

  p
    flex: 1
    margin: 0
    color: var(--card-meta)
    font-size: .92em
    line-height: 1.8

.research-timeline-detail-meta
  display: flex
  flex-wrap: wrap
  align-items: center
  gap: 8px
  color: var(--card-meta)
  font-size: .8em

.research-timeline-track
  padding: 3px 9px
  border-radius: 5px
  color: #fff
  background: #3573c9

  &.track-prototype
    background: #2f9e6f

  &.track-evaluation
    background: #b98a2f

.research-timeline-link
  display: inline-flex
  align-items: center
  gap: 8px
  margin-top: 18px
  padding-top: 16px
  border-top: 1px solid var(--light-grey)
  color: var(--btn-bg)
  font-size: .86em
  font-weight: 600
  line-height: 1.5
  text-decoration: none

  i
    flex: none
    font-size: 1em

  span
    min-width: 0
    overflow-wrap: anywhere

.research-timeline-axis
  stroke: var(--light-grey)
  stroke-width: 1

.research-timeline-lane
  stroke: var(--light-grey)
  stroke-dasharray: 4 7
  stroke-width: 1

.research-timeline-line
  fill: none
  stroke: var(--btn-bg)
  stroke-linecap: round
  stroke-linejoin: round
  stroke-width: 2.5

.research-timeline-point
  cursor: pointer
  outline: none

  .research-timeline-hit
    fill: transparent
    stroke: none

  circle:not(.research-timeline-hit)
    fill: var(--card-bg)
    stroke: var(--btn-bg)
    stroke-width: 4
    transition: r .2s ease, stroke-width .2s ease

  .research-timeline-label
    fill: var(--font-color)
    font-size: 18px
    font-weight: 600
    paint-order: stroke fill
    stroke: var(--card-bg)
    stroke-linejoin: round
    stroke-width: 5px
    transition: fill .2s ease

  &:hover,
  &:focus,
  &.is-active
    circle:not(.research-timeline-hit)
      r: 15
      stroke-width: 5

    .research-timeline-label
      fill: var(--btn-bg)

  &.track-literature circle:not(.research-timeline-hit)
    stroke: #3573c9

  &.track-prototype circle:not(.research-timeline-hit)
    stroke: #2f9e6f

  &.track-evaluation circle:not(.research-timeline-hit)
    stroke: #b98a2f

.research-empty
  padding: 40px
  border-radius: 8px
  background: var(--card-bg)
  box-shadow: var(--card-box-shadow)
  color: var(--card-meta)
  text-align: center

[data-theme='dark']
  .research-timeline-line
    stroke: #6cb6ff

  .research-timeline-detail
    h4
      color: var(--font-color)

    p
      color: var(--card-meta)

  .research-timeline-point
    circle:not(.research-timeline-hit)
      fill: var(--card-bg)

    .research-timeline-label
      stroke: var(--card-bg)

    &.track-literature circle:not(.research-timeline-hit)
      stroke: #6cb6ff

    &.track-prototype circle:not(.research-timeline-hit)
      stroke: #4cc38a

    &.track-evaluation circle:not(.research-timeline-hit)
      stroke: #d8a94a

  .research-timeline-track
    background: #6cb6ff

    &.track-prototype
      background: #4cc38a

    &.track-evaluation
      background: #d8a94a
