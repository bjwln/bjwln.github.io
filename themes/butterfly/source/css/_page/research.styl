.type-research
  #page.nc
    padding: 0 24px

    +maxWidth600()
      padding: 0 16px

  .page-title
    text-align: center

.research-container
  margin-bottom: 24px

.research-hero
  display: grid
  grid-template-columns: minmax(0, 1fr) 280px
  gap: 24px
  align-items: stretch
  padding: 4px 0 28px
  border-bottom: 1px solid var(--light-grey)

  +maxWidth900()
    grid-template-columns: 1fr
    gap: 20px

  +maxWidth600()
    padding-bottom: 20px

.research-hero-main
  min-width: 0

.research-eyebrow
  display: flex
  align-items: center
  gap: 8px
  color: var(--card-meta)
  font-size: .82em
  letter-spacing: 0

  i
    color: var(--btn-bg)

.research-heading
  margin: 10px 0 12px
  color: var(--font-color)
  font-size: 1.7em
  line-height: 1.35

.research-description
  margin: 0
  max-width: 680px
  color: var(--card-meta)
  line-height: 1.8

.research-hero-status
  display: flex
  flex-direction: column
  justify-content: center
  padding-left: 20px
  border-left: 3px solid var(--btn-bg)

.research-stage-label
  color: var(--card-meta)
  font-size: .78em

.research-stage-value
  margin-top: 8px
  color: var(--font-color)
  font-size: 1.08em
  font-weight: 600
  line-height: 1.6

.research-hero-stats
  display: grid
  grid-template-columns: repeat(3, 1fr)
  margin-top: 16px
  border-top: 1px solid var(--light-grey)

  +maxWidth600()
    grid-template-columns: repeat(3, minmax(0, 1fr))

.research-stat
  min-width: 0
  padding: 12px 4px 0
  text-align: center

  strong
    display: block
    color: var(--font-color)
    font-size: 1.18em
    line-height: 1.3

  span
    display: block
    margin-top: 3px
    color: var(--card-meta)
    font-size: .72em

.research-updated
  display: flex
  align-items: center
  gap: 6px
  margin-top: 14px
  color: var(--card-meta)
  font-size: .8em

  i
    color: var(--btn-bg)

.research-section
  margin-top: 30px

.research-section-heading
  display: flex
  align-items: center
  gap: 10px
  margin-bottom: 14px

  i
    color: var(--btn-bg)

  h3
    margin: 0
    color: var(--font-color)
    font-size: 1.25em

.research-track-grid
  display: grid
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr))
  gap: 16px

  +maxWidth600()
    grid-template-columns: 1fr
    gap: 12px

.research-track
  display: flex
  flex-direction: column
  padding: 18px 20px
  background: var(--card-bg)
  border-radius: 8px
  box-shadow: var(--card-box-shadow)
  transition: box-shadow .3s ease, transform .3s ease

  &:hover
    transform: translateY(-3px)
    box-shadow: var(--card-hover-box-shadow)

.research-track-header
  display: flex
  align-items: flex-start
  justify-content: space-between
  gap: 12px

.research-track-heading
  min-width: 0

  h4
    margin: 0
    color: var(--font-color)
    font-size: 1.05em

  span
    display: block
    margin-top: 4px
    color: var(--card-meta)
    font-size: .78em

.research-track-status
  flex-shrink: 0
  padding: 3px 8px
  border-radius: 6px
  color: #fff
  font-size: .72em
  line-height: 1.5

  .status-done &
    background: #2f9e6f

  .status-active &
    background: #3573c9

  .status-next &
    background: #8a6d3b

.research-track-desc
  margin: 12px 0 14px
  color: var(--card-meta)
  font-size: .9em
  line-height: 1.7

.research-progress-meta
  display: flex
  align-items: center
  justify-content: space-between
  margin-bottom: 6px
  color: var(--card-meta)
  font-size: .76em

.research-progress
  overflow: hidden
  width: 100%
  height: 7px
  border-radius: 4px
  background: var(--light-grey)

  span
    display: block
    height: 100%
    border-radius: inherit
    background: linear-gradient(90deg, #3573c9, #00a896)
    transition: width .3s ease

.research-track-details
  flex: 1
  margin: 14px 0 0
  padding: 0
  color: var(--card-meta)
  font-size: .84em
  line-height: 1.7
  list-style: none

  li
    position: relative
    padding-left: 16px

    &::before
      position: absolute
      top: .72em
      left: 0
      width: 5px
      height: 5px
      border-radius: 50%
      background: var(--btn-bg)
      content: ''

.research-track-links
  display: flex
  flex-wrap: wrap
  gap: 8px
  margin-top: 16px

  a
    display: inline-flex
    align-items: center
    gap: 6px
    padding: 6px 10px
    border: 1px solid var(--light-grey)
    border-radius: 6px
    color: var(--font-color)
    font-size: .8em
    text-decoration: none
    transition: border-color .2s ease, color .2s ease

    &:hover
      border-color: var(--btn-bg)
      color: var(--btn-bg)

.research-post-grid
  display: grid
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr))
  gap: 16px

  +maxWidth600()
    grid-template-columns: 1fr
    gap: 12px

.research-post-card
  display: flex
  flex-direction: column
  overflow: hidden
  background: var(--card-bg)
  border-radius: 8px
  box-shadow: var(--card-box-shadow)
  transition: box-shadow .3s ease, transform .3s ease

  &:hover
    transform: translateY(-3px)
    box-shadow: var(--card-hover-box-shadow)

    .research-post-title a
      color: var(--btn-bg)

.research-post-cover
  display: block
  aspect-ratio: 16 / 9
  overflow: hidden
  background: var(--light-grey)

  img
    display: block
    width: 100%
    height: 100%
    object-fit: cover
    transition: transform .3s ease

    .research-post-card:hover &
      transform: scale(1.03)

.research-post-cover-empty
  display: flex
  align-items: center
  justify-content: center
  color: var(--btn-bg)

  i
    font-size: 2em

.research-post-body
  display: flex
  flex: 1
  flex-direction: column
  padding: 16px 18px 18px

.research-post-meta
  display: flex
  flex-wrap: wrap
  align-items: center
  gap: 8px
  color: var(--card-meta)
  font-size: .78em

.research-post-tag
  padding: 1px 7px
  border-radius: 5px
  background: rgba(53, 115, 201, .12)
  color: #3573c9

.research-post-title
  margin: 10px 0 8px
  font-size: 1.04em
  line-height: 1.5

  a
    color: var(--font-color)
    text-decoration: none
    transition: color .2s ease

.research-post-desc
  display: -webkit-box
  overflow: hidden
  flex: 1
  margin: 0
  color: var(--card-meta)
  font-size: .84em
  line-height: 1.7
  -webkit-box-orient: vertical
  -webkit-line-clamp: 3
  line-clamp: 3

.research-post-link
  display: inline-flex
  align-items: center
  gap: 7px
  margin-top: 15px
  color: var(--btn-bg)
  font-size: .82em
  font-weight: 600
  text-decoration: none

  i
    font-size: 1em

.research-empty
  padding: 40px
  border-radius: 8px
  background: var(--card-bg)
  box-shadow: var(--card-box-shadow)
  color: var(--card-meta)
  text-align: center

[data-theme='dark']
  .research-stage-value
  .research-track-heading h4
  .research-section-heading h3
  .research-track-links a
  .research-post-title a
    color: var(--font-color)

  .research-post-tag
    background: rgba(108, 182, 255, .16)
    color: #6cb6ff

  .research-progress span
    background: linear-gradient(90deg, #6cb6ff, #4cc38a)
