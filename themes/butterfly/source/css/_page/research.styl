.type-research
  .layout.hide-aside
    max-width: 1600px

  #page.nc
    padding: 0 28px

    +maxWidth600()
      padding: 0 16px

  .page-title
    text-align: center

.research-container
  margin-bottom: 24px

.research-chart-section
  margin-top: 18px

  &:first-of-type
    margin-top: 18px

.research-progress-card
  margin-bottom: 14px
  padding: 18px 22px
  background: var(--card-bg)
  border-radius: 8px
  box-shadow: var(--card-box-shadow)

  +maxWidth600()
    padding: 16px 18px

.research-progress-header
  display: flex
  align-items: center
  justify-content: space-between
  flex-wrap: wrap
  gap: 6px 16px

  .research-progress-count
    flex: none
    color: var(--card-meta)
    font-size: .84em
    font-variant-numeric: tabular-nums

.research-progress
  overflow: hidden
  height: 8px
  margin-top: 14px
  border-radius: 999px
  background: var(--light-grey)

  span
    display: block
    width: 0
    height: 100%
    border-radius: inherit
    background: #3573c9
    transition: width .3s ease

  .plan-project &
    span
      background: #2f9e6f

  .plan-mciaa &
    span
      background: #8a5fd3

.research-progress-footer
  display: flex
  align-items: center
  justify-content: space-between
  gap: 14px
  margin-top: 10px
  color: var(--card-meta)
  font-size: .8em
  line-height: 1.5

  span
    min-width: 0

.research-progress-link
  display: inline-flex
  flex: none
  align-items: center
  gap: 6px
  color: var(--btn-bg)
  font-weight: 600
  text-decoration: none

.research-timeline-chart
  background: var(--card-bg)
  border-radius: 8px
  box-shadow: var(--card-box-shadow)

.research-timeline-viewport
  max-height: 700px
  overflow: auto
  padding: 36px 40px 28px
  scrollbar-width: thin
  scrollbar-color: rgba(128, 128, 128, .35) transparent

  &::-webkit-scrollbar
    width: 5px
    height: 5px

  &::-webkit-scrollbar-track
    background: transparent

  &::-webkit-scrollbar-thumb
    border-radius: 999px
    background: rgba(128, 128, 128, .35)

  &::-webkit-scrollbar-thumb:hover
    background: rgba(128, 128, 128, .55)

  +maxWidth600()
    padding: 24px 16px 20px

.research-timeline-strip
  position: relative
  display: flex
  align-items: stretch
  column-gap: 56px
  min-width: max-content
  padding: 0 12px

  &::before
    content: ''
    position: absolute
    top: 50%
    right: -32px
    left: -32px
    border-top: 2px dashed rgba(53, 115, 201, .38)
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 28px, #000 calc(100% - 28px), transparent)
    mask-image: linear-gradient(90deg, transparent, #000 28px, #000 calc(100% - 28px), transparent)

.research-timeline-item
  position: relative
  display: grid
  flex: none
  grid-template-rows: 1fr auto 1fr
  width: 264px

  +maxWidth600()
    width: 218px

.research-timeline-half
  display: flex
  flex-direction: column
  min-width: 0

  &.is-top
    justify-content: flex-end

  &.is-bottom
    justify-content: flex-start

.research-timeline-connector
  flex: 1
  width: 1px
  min-height: 36px
  margin: 0 auto
  background: rgba(128, 128, 128, .38)

.research-timeline-date
  color: var(--card-meta)
  font-size: .78em
  font-variant-numeric: tabular-nums
  letter-spacing: .02em
  text-align: center

  .is-top &
    padding: 0 0 10px

  .is-bottom &
    padding: 10px 0 0

.research-timeline-dot
  display: flex
  align-items: center
  justify-content: center
  height: 26px

.research-timeline-dot-core
  width: 12px
  height: 12px
  border: 3px solid #3573c9
  border-radius: 50%
  background: var(--card-bg)
  box-shadow: 0 0 0 4px rgba(53, 115, 201, .12)
  transition: transform .2s ease, box-shadow .2s ease

  .is-planned &
    border-style: dashed

  .research-timeline-item:hover &
    transform: scale(1.3)
    box-shadow: 0 0 0 6px rgba(53, 115, 201, .16)

.research-timeline-card
  display: flex
  flex-direction: column
  overflow: hidden
  border-radius: 12px
  background: var(--card-bg)
  box-shadow: 0 4px 16px rgba(0, 0, 0, .1), 0 0 0 1px rgba(0, 0, 0, .04)
  color: var(--font-color)
  text-decoration: none
  transition: transform .25s ease, box-shadow .25s ease

  &:hover
    transform: translateY(-4px)
    box-shadow: 0 10px 26px rgba(0, 0, 0, .14), 0 0 0 1px rgba(0, 0, 0, .04)

  &:focus-visible
    outline: 2px solid var(--btn-bg)
    outline-offset: 2px

.research-timeline-card-cover
  position: relative
  display: block
  aspect-ratio: 16 / 9
  background: var(--light-grey)

  img
    display: block
    width: 100%
    height: 100%
    object-fit: cover

.research-timeline-card-cover-bg
  display: block
  width: 100%
  height: 100%

.research-timeline-card-date
  position: absolute
  bottom: 8px
  left: 8px
  display: inline-flex
  align-items: center
  gap: 5px
  padding: 3px 8px
  border-radius: 6px
  background: rgba(0, 0, 0, .45)
  color: #fff
  font-size: .72em
  font-variant-numeric: tabular-nums
  backdrop-filter: blur(4px)

  i
    font-size: .95em

.research-timeline-card-body
  display: block
  padding: 12px 14px 0

.research-timeline-card-meta
  display: flex
  align-items: center
  gap: 8px
  font-size: .74em

.research-timeline-track
  color: #3573c9
  font-weight: 600

  &.track-system
    color: #2f9e6f

  &.track-skill
    color: #b98a2f

.research-timeline-status
  padding: 1px 7px
  border-radius: 4px
  color: var(--card-meta)
  background: var(--light-grey)

.research-timeline-card-title
  display: -webkit-box
  margin-top: 6px
  overflow: hidden
  -webkit-box-orient: vertical
  -webkit-line-clamp: 2
  color: var(--font-color)
  font-size: .96em
  font-weight: 600
  line-height: 1.45
  transition: color .2s ease
  word-break: break-word

  .research-timeline-card:hover &
    color: var(--btn-bg)

.research-timeline-card-summary
  display: -webkit-box
  margin-top: 6px
  overflow: hidden
  -webkit-box-orient: vertical
  -webkit-line-clamp: 3
  color: var(--card-meta)
  font-size: .82em
  line-height: 1.7

.research-timeline-card-footer
  display: flex
  justify-content: flex-end
  padding: 10px 12px 12px

  i
    color: var(--card-meta)
    font-size: .85em
    transform: rotate(-45deg)
    transition: color .2s ease, transform .2s ease

  .research-timeline-card:hover &
    i
      color: var(--btn-bg)
      transform: rotate(-45deg) translate(2px, -2px)

.research-timeline-popover
  position: fixed
  left: 0
  top: 0
  z-index: 1002
  width: calc(100vw - 24px)
  max-width: 440px
  max-height: 66vh
  overflow-y: auto
  padding: 14px 16px 13px
  border-radius: 10px
  background: var(--card-bg)
  box-shadow: 0 12px 34px rgba(0, 0, 0, .24), 0 0 0 1px rgba(0, 0, 0, .05)
  opacity: 0
  visibility: hidden
  transform-origin: 0 0
  transition: opacity .18s ease, visibility .18s
  scrollbar-width: thin
  scrollbar-color: rgba(128, 128, 128, .35) transparent

  &.is-visible
    opacity: 1
    visibility: visible

  .research-timeline-popover-meta
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: 8px
    color: var(--card-meta)
    font-size: .78em
    font-variant-numeric: tabular-nums

  .research-timeline-popover-title
    display: block
    margin: 8px 0 6px
    color: var(--font-color)
    font-size: .97em
    font-weight: 600
    line-height: 1.5
    overflow-wrap: break-word

  .research-timeline-popover-summary
    display: block
    margin: 0
    color: var(--card-meta)
    font-size: .84em
    line-height: 1.85
    overflow-wrap: break-word

.research-empty
  padding: 40px
  border-radius: 8px
  background: var(--card-bg)
  box-shadow: var(--card-box-shadow)
  color: var(--card-meta)
  text-align: center

[data-theme='dark']
  .research-timeline-strip
    &::before
      border-top-color: rgba(108, 182, 255, .32)

  .research-timeline-connector
    background: rgba(170, 170, 170, .28)

  .research-timeline-dot-core
    border-color: #6cb6ff
    box-shadow: 0 0 0 4px rgba(108, 182, 255, .14)

    .research-timeline-item:hover &
      box-shadow: 0 0 0 6px rgba(108, 182, 255, .2)

  .is-planned .research-timeline-dot-core
    border-style: dashed

  .research-timeline-track
    color: #6cb6ff

    &.track-system
      color: #4cc38a

    &.track-skill
      color: #d8a94a

  .research-timeline-card
    box-shadow: 0 4px 16px rgba(0, 0, 0, .35), 0 0 0 1px rgba(255, 255, 255, .06)

    &:hover
      box-shadow: 0 10px 26px rgba(0, 0, 0, .45), 0 0 0 1px rgba(255, 255, 255, .08)

    .research-timeline-card-date
      background: rgba(0, 0, 0, .55)

  .research-timeline-popover
    box-shadow: 0 12px 34px rgba(0, 0, 0, .55), 0 0 0 1px rgba(255, 255, 255, .08)

// ==================== 任务标题切换(进度卡标题栏内) ====================
.research-task-tabs
  display: flex
  flex-wrap: wrap
  align-items: baseline
  gap: 6px 40px
  min-width: 0

  +maxWidth600()
    gap: 4px 22px

.research-task-tab
  display: inline-flex
  align-items: baseline
  gap: 7px
  padding: 2px 1px 8px
  border: none
  border-bottom: 2px solid transparent
  background: none
  color: var(--card-meta)
  font-size: 1.08em
  font-weight: 700
  line-height: 1.4
  cursor: pointer
  transition: color .2s ease, border-color .2s ease

  +maxWidth600()
    gap: 5px
    font-size: .98em

  &:hover
    color: var(--chart-accent)

  &:focus-visible
    outline: 2px solid var(--chart-accent)
    outline-offset: 2px
    border-radius: 4px

  .research-task-tab-count
    color: var(--card-meta)
    font-size: .68em
    font-weight: 500
    font-variant-numeric: tabular-nums

  &.is-active
    border-bottom-color: var(--chart-accent)
    color: var(--font-color)

    .research-task-tab-count
      color: var(--chart-accent)

// 每个任务的主题色(标题 Tab 下划线 / 徽标共用;折线图颜色由 JS 内联注入)
.research-task-tab.plan-literature,
.research-chart-section.plan-literature
  --chart-accent: #3573c9

.research-task-tab.plan-project,
.research-chart-section.plan-project
  --chart-accent: #2f9e6f

.research-task-tab.plan-mciaa,
.research-chart-section.plan-mciaa
  --chart-accent: #8a5fd3

// 切换显隐:只有激活的任务大框可见
.research-chart-section
  display: none

  &.is-active
    display: block
    animation: research-section-in .32s ease

@keyframes research-section-in
  from
    opacity: 0
    transform: translateY(10px)

  to
    opacity: 1
    transform: none

.research-unlimited-chip
  display: inline-block
  vertical-align: 3px
  margin-left: 8px
  padding: 2px 9px
  border-radius: 999px
  background: var(--chart-accent)
  color: #fff
  font-size: .62em
  font-weight: 600
  letter-spacing: .04em

// ==================== 阅读曲线(折线图) ====================
.research-linechart-card
  margin-bottom: 14px
  padding: 16px 20px 12px
  background: var(--card-bg)
  border-radius: 8px
  box-shadow: var(--card-box-shadow)

  +maxWidth600()
    padding: 14px 14px 10px

.research-linechart-header
  display: flex
  align-items: baseline
  justify-content: space-between
  gap: 12px

.research-linechart-title
  display: inline-flex
  align-items: center
  gap: 7px
  color: var(--font-color)
  font-size: .95em

  i
    color: var(--chart-accent)

.research-linechart-subtitle
  color: var(--card-meta)
  font-size: .78em

.research-linechart-body
  position: relative
  margin-top: 8px

  svg
    display: block
    max-width: 100%

.rlc-grid
  stroke: rgba(128, 128, 128, .16)

.rlc-grid-base
  stroke: rgba(128, 128, 128, .34)

.rlc-axis
  fill: var(--card-meta)
  font-size: 11px
  font-variant-numeric: tabular-nums

.rlc-area
  fill: var(--chart-accent)
  opacity: .12

.rlc-line
  fill: none
  stroke: var(--chart-accent)
  stroke-width: 2.5
  stroke-linecap: round
  stroke-linejoin: round

.rlc-target
  stroke: var(--chart-accent)
  stroke-dasharray: 5 5
  opacity: .55

.rlc-target-label
  fill: var(--card-meta)

.rlc-dot
  cursor: pointer

  .rlc-dot-hit
    fill: transparent

  .rlc-dot-core
    fill: var(--card-bg)
    stroke: var(--chart-accent)
    stroke-width: 2.5
    transition: transform .18s ease
    transform-box: fill-box
    transform-origin: center

  &:hover .rlc-dot-core,
  &:focus .rlc-dot-core
    transform: scale(1.45)

  &:focus
    outline: none

    .rlc-dot-core
      stroke-width: 3.5

.rlc-tip
  position: absolute
  left: 0
  top: 0
  z-index: 6
  max-width: 300px
  padding: 10px 13px
  border-radius: 8px
  background: var(--card-bg)
  box-shadow: 0 10px 26px rgba(0, 0, 0, .2), 0 0 0 1px rgba(0, 0, 0, .05)
  opacity: 0
  visibility: hidden
  transition: opacity .16s ease, visibility .16s
  pointer-events: none

  &.is-visible
    opacity: 1
    visibility: visible

  .rlc-tip-meta
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: 8px
    color: var(--card-meta)
    font-size: .74em
    font-variant-numeric: tabular-nums

  .rlc-tip-title
    display: block
    margin-top: 6px
    color: var(--font-color)
    font-size: .84em
    font-weight: 600
    line-height: 1.5
    word-break: break-word

.research-linechart-placeholder
  padding: 38px 10px
  color: var(--card-meta)
  font-size: .84em
  text-align: center

[data-theme='dark']
  .research-task-tab.plan-literature,
  .research-chart-section.plan-literature
    --chart-accent: #6cb6ff

  .research-task-tab.plan-project,
  .research-chart-section.plan-project
    --chart-accent: #4cc38a

  .research-task-tab.plan-mciaa,
  .research-chart-section.plan-mciaa
    --chart-accent: #b79bff

  .rlc-grid
    stroke: rgba(170, 170, 170, .14)

  .rlc-grid-base
    stroke: rgba(170, 170, 170, .3)

  .rlc-tip
    box-shadow: 0 10px 26px rgba(0, 0, 0, .5), 0 0 0 1px rgba(255, 255, 255, .07)
