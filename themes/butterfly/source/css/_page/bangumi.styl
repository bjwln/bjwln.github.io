.type-bangumi
  #page.nc
    padding: 0 24px

    +maxWidth600()
      padding: 0 16px

  .page-title
    text-align: center

.container
  .bangumi
    margin-bottom: 20px

    .bangumi-grid
      display: grid
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr))
      gap: 16px

      +maxWidth600()
        grid-template-columns: repeat(auto-fill, minmax(145px, 1fr))
        gap: 12px

    .bangumi-card
      display: flex
      flex-direction: column
      overflow: hidden
      background: var(--card-bg)
      border-radius: 8px
      box-shadow: var(--card-box-shadow)
      text-decoration: none
      transition: transform .3s ease, box-shadow .3s ease

      &:hover
        transform: translateY(-4px)
        box-shadow: var(--card-hover-box-shadow)

        .bangumi-title
          color: var(--btn-bg)

        .bangumi-cover img
          transform: scale(1.04)

      &:focus-visible
        outline: 2px solid var(--btn-bg)
        outline-offset: 2px

    .bangumi-cover
      position: relative
      aspect-ratio: 2 / 3
      overflow: hidden
      background: var(--text-bg-hover)

      img
        display: block
        width: 100%
        height: 100%
        object-fit: cover
        transition: transform .3s ease

      .bangumi-episode
        position: absolute
        top: 8px
        right: 8px
        padding: 3px 7px
        background: rgba(0, 0, 0, .78)
        border-radius: 6px
        color: #fff
        font-size: .72em
        line-height: 1.4

    .bangumi-info
      padding: 12px 14px 14px

    .bangumi-title
      @extend .limit-one-line
      color: var(--font-color)
      font-size: 1em
      font-weight: 600
      transition: color .3s ease

    .bangumi-author
      margin-top: 4px
      color: var(--card-meta)
      font-size: .82em

    .bangumi-intro
      display: -webkit-box
      overflow: hidden
      margin-top: 8px
      color: var(--card-meta)
      font-size: .78em
      line-height: 1.6
      -webkit-box-orient: vertical
      -webkit-line-clamp: 3
      line-clamp: 3

.container
  .bangumi
    .bangumi-tabs
      display: flex
      flex-wrap: wrap
      gap: 8px
      margin-bottom: 24px

    .bangumi-tab
      padding: 5px 14px
      border: 1px solid var(--text-bg-hover)
      border-radius: 999px
      background: var(--card-bg)
      color: var(--card-meta)
      font-size: .82em
      cursor: pointer
      transition: color .2s ease, border-color .2s ease, background .2s ease

      em
        font-style: normal
        opacity: .65
        margin-left: 2px

      &:hover
        color: var(--btn-bg)
        border-color: var(--btn-bg)

      &.is-active
        background: var(--btn-bg)
        border-color: var(--btn-bg)
        color: #fff

        em
          opacity: .9

    .bangumi-cover
      .bangumi-category
        position: absolute
        top: 8px
        left: 8px
        padding: 3px 7px
        background: rgba(0, 0, 0, .55)
        border-radius: 6px
        color: #fff
        font-size: .72em
        line-height: 1.4

    .bangumi-meta-row
      display: flex
      align-items: center
      justify-content: space-between
      gap: 8px
      margin-top: 4px

      .bangumi-author
        margin-top: 0

    .bangumi-status
      flex: none
      padding: 1px 7px
      border-radius: 5px
      color: var(--st, #71717a)
      background: unquote('color-mix(in srgb, var(--st, #71717a) 14%, transparent)')
      font-size: .72em
      font-weight: 600

    .bangumi-empty
      grid-column: 1 / -1
      padding: 30px
      color: var(--card-meta)
      font-size: .9em
      text-align: center

    .bangumi-cover
      .bangumi-total
        position: absolute
        top: 36px
        right: 8px
        padding: 3px 7px
        background: rgba(0, 0, 0, .78)
        border-radius: 6px
        color: rgba(255, 255, 255, .85)
        font-size: .72em
        line-height: 1.4

        // 有新集时:琥珀描边提示,文字保持白色保证可读性
        &.is-new
          box-shadow: 0 0 0 1.5px rgba(251, 191, 36, .9)

      .bangumi-episode.is-new
        box-shadow: 0 0 0 1.5px rgba(251, 191, 36, .9)
        font-weight: 600

// 容器显隐(hidden 属性会被 display:grid 覆盖,需强制)
.bangumi [hidden]
  display: none !important

.bangumi-loading
  padding: 46px
  color: var(--card-meta)
  text-align: center

  i
    margin-right: 8px

// 「未看 N 集」琥珀角标:有新集可看的条目排在前面(与排序对应);
// 有此角标时 JS 不再渲染分类角标,两者同位不重叠
.bangumi-cover .bangumi-unwatch
  position: absolute
  top: 8px
  left: 8px
  padding: 3px 9px
  border-radius: 6px
  background: rgba(245, 158, 11, .92)
  color: #111
  font-size: .72em
  font-weight: 700
  line-height: 1.4

.bangumi-latest
  display: flex
  align-items: center
  gap: 7px
  margin-top: 8px
  padding: 7px 10px
  border-radius: 6px
  background: rgba(128, 128, 128, .14)
  color: var(--card-meta)
  font-size: .78em
  line-height: 1.5
  overflow: hidden

  i
    flex: none
    color: var(--text-highlight-color)

  span
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap

// ============================================================
// ★ starlite 美化层（追加于文件尾部，规则在后优先）
//   无框星空风 · 双模式：只改视觉属性，不动 JS 类名契约
// ============================================================

// 去底板：压过 custom.css 的 div#page 卡片底色（白天/夜间两条都要）
.type-bangumi div#page,
[data-theme="dark"] .type-bangumi div#page
  background: transparent !important
  border: none !important
  box-shadow: none !important
  border-radius: 0 !important
  padding: 0 28px !important

  +maxWidth600()
    padding: 0 16px !important

// 页标题：衬线金字（带 #page 提高优先级，压过主题 #page .page-title 的 margin/font-size）
.type-bangumi #page .page-title,
.type-bangumi .page-title
  text-align: center
  font-family: "Noto Serif SC", "Source Han Serif SC", "STZhongsong", "SimSun", serif
  font-size: 1.6em
  letter-spacing: 8px
  text-indent: 8px
  color: #8a6a26
  margin-bottom: 28px

[data-theme="dark"] .type-bangumi .page-title
  color: #e8d9a0

// 卡片磨砂化
.container
  .bangumi
    .bangumi-card
      background: rgba(255, 255, 255, .66)
      border: 1px solid rgba(0, 0, 0, .07)
      border-radius: 12px
      box-shadow: 0 8px 22px rgba(0, 0, 0, .08)
      backdrop-filter: blur(8px)
      -webkit-backdrop-filter: blur(8px)

      &:hover
        box-shadow: 0 14px 30px rgba(0, 0, 0, .14)

        .bangumi-title
          color: #8a6a26

      &:focus-visible
        outline-color: #b99c4d

    // 分类 tab 金色化
    .bangumi-tab
      background: rgba(120, 94, 32, .08)
      border-color: rgba(0, 0, 0, .06)

      &:hover
        color: #8a6a26
        border-color: #b99c4d

      &.is-active
        background: linear-gradient(180deg, #efe3b6, #e2d193)
        border-color: transparent
        color: #3a3527

    .bangumi-latest
      background: rgba(120, 94, 32, .08)

      i
        color: #b08d3a

// 夜间模式：深色磨砂 + 金
[data-theme="dark"]
  .container .bangumi .bangumi-card
    background: rgba(20, 20, 31, .72)
    border-color: rgba(232, 217, 160, .16)
    box-shadow: 0 8px 22px rgba(0, 0, 0, .4)

    &:hover
      box-shadow: 0 14px 32px rgba(0, 0, 0, .5)
      border-color: rgba(232, 217, 160, .32)

      .bangumi-title
        color: #e8d9a0

    &:focus-visible
      outline-color: #e8d9a0

  .container .bangumi .bangumi-tab
    background: rgba(232, 217, 160, .08)
    border-color: rgba(232, 217, 160, .14)

    &:hover
      color: #e8d9a0
      border-color: rgba(232, 217, 160, .4)

    &.is-active
      background: #e8d9a0
      border-color: #e8d9a0
      color: #2a2618

      em
        opacity: .75

  .container .bangumi .bangumi-latest
    background: rgba(232, 217, 160, .07)

    i
      color: #e8d9a0
