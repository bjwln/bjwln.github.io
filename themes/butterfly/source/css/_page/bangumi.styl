.type-bangumi
  #page.nc
    padding: 0 24px

    +maxWidth600()
      padding: 0 16px

  .page-title
    text-align: center

.container
  .bangumi
    margin-bottom: 20px

    .bangumi-grid
      display: grid
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr))
      gap: 16px

      +maxWidth600()
        grid-template-columns: repeat(auto-fill, minmax(145px, 1fr))
        gap: 12px

    .bangumi-card
      display: flex
      flex-direction: column
      overflow: hidden
      background: var(--card-bg)
      border-radius: 8px
      box-shadow: var(--card-box-shadow)
      text-decoration: none
      transition: transform .3s ease, box-shadow .3s ease

      &:hover
        transform: translateY(-4px)
        box-shadow: var(--card-hover-box-shadow)

        .bangumi-title
          color: var(--btn-bg)

        .bangumi-cover img
          transform: scale(1.04)

      &:focus-visible
        outline: 2px solid var(--btn-bg)
        outline-offset: 2px

    .bangumi-cover
      position: relative
      aspect-ratio: 2 / 3
      overflow: hidden
      background: var(--text-bg-hover)

      img
        display: block
        width: 100%
        height: 100%
        object-fit: cover
        transition: transform .3s ease

      .bangumi-episode
        position: absolute
        top: 8px
        right: 8px
        padding: 3px 7px
        background: rgba(0, 0, 0, .68)
        border-radius: 6px
        color: #fff
        font-size: .72em
        line-height: 1.4

    .bangumi-info
      padding: 12px 14px 14px

    .bangumi-title
      @extend .limit-one-line
      color: var(--font-color)
      font-size: 1em
      font-weight: 600
      transition: color .3s ease

    .bangumi-author
      margin-top: 4px
      color: var(--card-meta)
      font-size: .82em

    .bangumi-intro
      display: -webkit-box
      overflow: hidden
      margin-top: 8px
      color: var(--card-meta)
      font-size: .78em
      line-height: 1.6
      -webkit-box-orient: vertical
      -webkit-line-clamp: 3
      line-clamp: 3

.container
  .bangumi
    .bangumi-tabs
      display: flex
      flex-wrap: wrap
      gap: 8px
      margin-bottom: 16px

    .bangumi-tab
      padding: 5px 14px
      border: 1px solid var(--text-bg-hover)
      border-radius: 999px
      background: var(--card-bg)
      color: var(--card-meta)
      font-size: .82em
      cursor: pointer
      transition: color .2s ease, border-color .2s ease, background .2s ease

      em
        font-style: normal
        opacity: .65
        margin-left: 2px

      &:hover
        color: var(--btn-bg)
        border-color: var(--btn-bg)

      &.is-active
        background: var(--btn-bg)
        border-color: var(--btn-bg)
        color: #fff

        em
          opacity: .9

    .bangumi-cover
      .bangumi-category
        position: absolute
        top: 8px
        left: 8px
        padding: 3px 7px
        background: rgba(0, 0, 0, .55)
        border-radius: 6px
        color: #fff
        font-size: .72em
        line-height: 1.4

    .bangumi-meta-row
      display: flex
      align-items: center
      justify-content: space-between
      gap: 8px
      margin-top: 4px

      .bangumi-author
        margin-top: 0

    .bangumi-status
      flex: none
      padding: 1px 7px
      border-radius: 5px
      color: var(--st, #71717a)
      background: unquote('color-mix(in srgb, var(--st, #71717a) 14%, transparent)')
      font-size: .72em
      font-weight: 600

    .bangumi-empty
      grid-column: 1 / -1
      padding: 30px
      color: var(--card-meta)
      font-size: .9em
      text-align: center

    .bangumi-cover
      .bangumi-total
        position: absolute
        top: 36px
        right: 8px
        padding: 3px 7px
        background: rgba(0, 0, 0, .68)
        border-radius: 6px
        color: rgba(255, 255, 255, .85)
        font-size: .72em
        line-height: 1.4

        // 有新集时:深底 + 琥珀色字,保持醒目但清晰可读
        &.is-new
          color: #fbbf24
          font-weight: 600

      .bangumi-episode.is-new
        color: #fbbf24
        font-weight: 600
