.type-bangumi
  #page.nc
    padding: 0 24px

    +maxWidth600()
      padding: 0 16px

  .page-title
    text-align: center

.container
  .bangumi
    margin-bottom: 20px

    .bangumi-grid
      display: grid
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr))
      gap: 16px

      +maxWidth600()
        grid-template-columns: repeat(auto-fill, minmax(145px, 1fr))
        gap: 12px

    // 「追更动态」宽卡专属网格:16:9 大卡单独成区,不与海报卡混排
    .bangumi-grid.is-wide
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr))
      gap: 18px

      +maxWidth768()
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr))

      +maxWidth600()
        grid-template-columns: 1fr
        gap: 14px

    .bangumi-card
      display: flex
      flex-direction: column
      overflow: hidden
      background: var(--card-bg)
      border-radius: 8px
      box-shadow: var(--card-box-shadow)
      text-decoration: none
      transition: transform .3s ease, box-shadow .3s ease

      &:hover
        transform: translateY(-4px)
        box-shadow: var(--card-hover-box-shadow)

        .bangumi-title
          color: var(--btn-bg)

        .bangumi-cover img
          transform: scale(1.04)

      &:focus-visible
        outline: 2px solid var(--btn-bg)
        outline-offset: 2px

    .bangumi-cover
      position: relative
      aspect-ratio: 2 / 3
      overflow: hidden
      background: var(--text-bg-hover)

      img
        display: block
        width: 100%
        height: 100%
        object-fit: cover
        transition: transform .3s ease

      .bangumi-episode
        position: absolute
        top: 8px
        right: 8px
        padding: 3px 7px
        background: rgba(0, 0, 0, .78)
        border-radius: 6px
        color: #fff
        font-size: .72em
        line-height: 1.4

    .bangumi-info
      padding: 12px 14px 14px

    .bangumi-title
      @extend .limit-one-line
      color: var(--font-color)
      font-size: 1em
      font-weight: 600
      transition: color .3s ease

    .bangumi-author
      margin-top: 4px
      color: var(--card-meta)
      font-size: .82em

    .bangumi-intro
      display: -webkit-box
      overflow: hidden
      margin-top: 8px
      color: var(--card-meta)
      font-size: .78em
      line-height: 1.6
      -webkit-box-orient: vertical
      -webkit-line-clamp: 3
      line-clamp: 3

.container
  .bangumi
    .bangumi-tabs
      display: flex
      flex-wrap: wrap
      gap: 8px
      margin-bottom: 16px

    .bangumi-tab
      padding: 5px 14px
      border: 1px solid var(--text-bg-hover)
      border-radius: 999px
      background: var(--card-bg)
      color: var(--card-meta)
      font-size: .82em
      cursor: pointer
      transition: color .2s ease, border-color .2s ease, background .2s ease

      em
        font-style: normal
        opacity: .65
        margin-left: 2px

      &:hover
        color: var(--btn-bg)
        border-color: var(--btn-bg)

      &.is-active
        background: var(--btn-bg)
        border-color: var(--btn-bg)
        color: #fff

        em
          opacity: .9

    .bangumi-cover
      .bangumi-category
        position: absolute
        top: 8px
        left: 8px
        padding: 3px 7px
        background: rgba(0, 0, 0, .55)
        border-radius: 6px
        color: #fff
        font-size: .72em
        line-height: 1.4

    .bangumi-meta-row
      display: flex
      align-items: center
      justify-content: space-between
      gap: 8px
      margin-top: 4px

      .bangumi-author
        margin-top: 0

    .bangumi-status
      flex: none
      padding: 1px 7px
      border-radius: 5px
      color: var(--st, #71717a)
      background: unquote('color-mix(in srgb, var(--st, #71717a) 14%, transparent)')
      font-size: .72em
      font-weight: 600

    .bangumi-empty
      grid-column: 1 / -1
      padding: 30px
      color: var(--card-meta)
      font-size: .9em
      text-align: center

    .bangumi-cover
      .bangumi-total
        position: absolute
        top: 36px
        right: 8px
        padding: 3px 7px
        background: rgba(0, 0, 0, .78)
        border-radius: 6px
        color: rgba(255, 255, 255, .85)
        font-size: .72em
        line-height: 1.4

        // 有新集时:琥珀描边提示,文字保持白色保证可读性
        &.is-new
          box-shadow: 0 0 0 1.5px rgba(251, 191, 36, .9)

      .bangumi-episode.is-new
        box-shadow: 0 0 0 1.5px rgba(251, 191, 36, .9)
        font-weight: 600

// 容器显隐(hidden 属性会被 display:grid 覆盖,需强制)
.bangumi [hidden]
  display: none !important

.bangumi-loading
  padding: 46px
  color: var(--card-meta)
  text-align: center

  i
    margin-right: 8px

// UP主追踪大卡片(有最新视频信息的条目,位于「追更动态」专属宽卡网格)
.bangumi-card.is-up
  .bangumi-cover
    aspect-ratio: 16 / 9

  .bangumi-intro
    -webkit-line-clamp: 2
    line-clamp: 2

  .bangumi-play
    position: absolute
    top: 50%
    left: 50%
    display: flex
    align-items: center
    justify-content: center
    width: 44px
    height: 44px
    border-radius: 50%
    background: rgba(0, 0, 0, .55)
    color: #fff
    font-size: .9em
    transform: translate(-50%, -50%)
    backdrop-filter: blur(4px)
    transition: transform .25s ease, background .25s ease

  &:hover .bangumi-play
    background: rgba(0, 0, 0, .75)
    transform: translate(-50%, -50%) scale(1.12)

  .bangumi-unwatch
    position: absolute
    top: 8px
    left: 8px
    padding: 3px 9px
    border-radius: 6px
    background: rgba(245, 158, 11, .92)
    color: #111
    font-size: .72em
    font-weight: 700
    line-height: 1.4

.bangumi-latest
  display: flex
  align-items: center
  gap: 7px
  margin-top: 8px
  padding: 7px 10px
  border-radius: 6px
  background: rgba(128, 128, 128, .14)
  color: var(--card-meta)
  font-size: .78em
  line-height: 1.5
  overflow: hidden

  i
    flex: none
    color: var(--text-highlight-color)

  span
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap

// 分区块:「追更动态」(宽卡)与「作品墙」(海报)
.bangumi .bangumi-section
  margin-bottom: 26px

  &:last-child
    margin-bottom: 0

.bangumi .bangumi-section-title
  display: flex
  align-items: center
  gap: 8px
  margin-bottom: 12px
  color: var(--font-color)
  font-size: 1.05em
  font-weight: 600

  i
    color: var(--btn-bg)
    font-size: .92em

  em
    font-style: normal
    padding: 1px 8px
    border-radius: 999px
    background: var(--text-bg-hover)
    color: var(--card-meta)
    font-size: .72em
    font-weight: 500
