#article-container.container
  .bangumi
    //- 动态数据容器(API 渲染)
    #bangumi-grid.bangumi-grid(hidden)
    //- 首访加载指示
    #bangumi-loading.bangumi-loading
      i.fas.fa-spinner.fa-spin
      |  加载中...
    //- 静态兜底(bangumi.yml 渲染,仅在 API 失败或无 JS 时显示)
    #bangumi-fallback(hidden)
      .bangumi-grid
        each item in site.data.bangumi.items
          - const episodeText = item.episode === '看完' ? '看完' : `看到第 ${item.episode} 集`
          a.bangumi-card(href=item.link target="_blank" rel="noopener noreferrer" title=item.title)
            .bangumi-cover
              img(src=item.image alt=item.title + '封面' loading='lazy' decoding='async')
              if item.episode
                span.bangumi-episode= episodeText
            .bangumi-info
              .bangumi-title= item.title
              .bangumi-author= item.author
              if item.intro
                .bangumi-intro= item.intro
  noscript
    style
      | #bangumi-fallback { display: block !important; }
      | #bangumi-loading { display: none !important; }

  script(src=(url_for('/js/bangumi.js') + '?v=20261107c') defer)
