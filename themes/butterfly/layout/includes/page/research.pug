#article-container.research-container.container
  - const research = site.data.research || {}
  - const researchPosts = site.posts.filter(post => post.research).sort('-date').toArray()
  - const plans = research.plans || []
  - const linkedPostFor = (posts, title) => posts.find(post => post.title === title)

  mixin researchCard(point)
    a.research-timeline-card(href=point.href title=point.title aria-label=`${point.dateStr} ${point.title}`)
      if point.cover
        span.research-timeline-card-cover
          if point.coverIsImg
            img(src=point.cover alt='' loading='lazy' draggable='false')
          else
            span.research-timeline-card-cover-bg(style=`background: ${point.cover}`)
          span.research-timeline-card-date
            i.fas.fa-calendar(aria-hidden='true')
            span= point.dateStr
      span.research-timeline-card-body
        span.research-timeline-card-meta
          span.research-timeline-track(class=`track-${point.item.track}`)= point.trackLabel
          if point.planned
            span.research-timeline-status 规划中
        span.research-timeline-card-title= point.title
        if point.item.summary
          span.research-timeline-card-summary= point.item.summary
      span.research-timeline-card-footer(aria-hidden='true')
        i.fas.fa-arrow-right

  - const chartData = plans.map(plan => {
  -   const timeline = (plan.timeline || []).slice().sort((a, b) => {
  -     const dateDiff = new Date(a.date) - new Date(b.date)
  -     return dateDiff || (Number(a.order) || 0) - (Number(b.order) || 0)
  -   })
  -   const tracks = plan.tracks || []
  -   const trackLabel = key => (tracks.find(track => track.key === key) || {}).axis_label || ''
  -   const items = timeline.map(item => {
  -     const linkedPost = linkedPostFor(researchPosts, item.link)
  -     const cover = (linkedPost && linkedPost.cover) || ''
  -     const coverUrl = !cover || /^(https?:)?\/\//.test(cover) || cover[0] === '/' ? cover : '/' + cover
  -     return { item, href: linkedPost ? url_for(linkedPost.path) : url_for(item.link), title: item.label || (linkedPost ? linkedPost.title : item.title), cover: cover ? url_for(coverUrl) : '', coverIsImg: Boolean(cover && linkedPost.cover_type === 'img'), trackLabel: trackLabel(item.track), dateStr: date(item.date, 'YYYY-MM-DD'), planned: item.status === 'planned' }
  -   })
  -   const unlimited = Boolean(plan.unlimited)
  -   const completed = unlimited ? items.length : Number(plan.completed) || 0
  -   const total = unlimited ? 0 : Number(plan.total) || 0
  -   const percent = total ? Math.round((completed / total) * 100) : 0
  -   const planPost = linkedPostFor(researchPosts, plan.plan_link)
  -   const planHref = String(plan.plan_link || '').startsWith('/') ? url_for(plan.plan_link) : (planPost ? url_for(planPost.path) : url_for(plan.plan_link))
  -   const chartPoints = items.map(point => ({ date: point.dateStr, title: point.title, href: point.href, track: point.item.track || '', trackLabel: point.trackLabel }))
  -   return { plan, items, unlimited, completed, total, percent, planPost, planHref, chartPoints }
  - })

  if chartData.length
    nav.research-tabs(role='tablist' aria-label='科研任务切换')
      each chart, chartIndex in chartData
        button.research-tab(class=`plan-${chart.plan.key}${chartIndex === 0 ? ' is-active' : ''}` type='button' role='tab' id=`research-tab-${chart.plan.key}` data-plan=chart.plan.key aria-controls=`plan-${chart.plan.key}` aria-selected=chartIndex === 0 ? 'true' : 'false')
          span.research-tab-name= chart.plan.title
          span.research-tab-count= chart.unlimited ? `已读 ${chart.completed}${chart.plan.unit ? ' ' + chart.plan.unit : ''}` : `${chart.completed}/${chart.total}${chart.plan.unit ? ' ' + chart.plan.unit : ''}`

  each chart, chartIndex in chartData
    section.research-chart-section(id=`plan-${chart.plan.key}` class=`plan-${chart.plan.key}${chartIndex === 0 ? ' is-active' : ''}` data-plan-section=chart.plan.key role='tabpanel' aria-labelledby=`research-tab-${chart.plan.key}` aria-label=`${chart.plan.title}科研时间线`)
      article.research-progress-card
        header.research-progress-header
          h3
            = chart.plan.title
            if chart.unlimited
              span.research-unlimited-chip 不限量
          span.research-progress-count= chart.unlimited ? `已读 ${chart.completed}${chart.plan.unit ? ' ' + chart.plan.unit : ''}` : `${chart.completed}/${chart.total} ${chart.plan.unit || ''}`
        if !chart.unlimited
          .research-progress(role='progressbar' aria-valuemin='0' aria-valuemax='100' aria-valuenow=chart.percent aria-label=`${chart.plan.title}进度`)
            span(style=`width: ${chart.percent}%`)
        .research-progress-footer
          span= chart.plan.goal
          if chart.planHref
            a.research-progress-link(href=chart.planHref title=chart.planPost ? chart.planPost.title : chart.plan.title)
              i.fas.fa-list-check
              span 查看规划

      div.research-linechart-card(aria-label=`${chart.plan.title}阅读曲线`)
        header.research-linechart-header
          span.research-linechart-title
            i.fas.fa-chart-line(aria-hidden='true')
            strong 阅读曲线
          span.research-linechart-subtitle= chart.unlimited ? '累计已读文献 · 持续记录' : '累计已读文献'
        .research-linechart-body
          script(type='application/json' class='research-linechart-data')!= JSON.stringify({ unlimited: chart.unlimited, total: chart.unlimited ? null : chart.total, points: chart.chartPoints }).replace(/</g, '\\u003c')

      if chart.items.length
        section.research-timeline-chart
          .research-timeline-viewport
            .research-timeline-strip
              each point, pointIndex in chart.items
                - const isAbove = pointIndex % 2 === 0
                .research-timeline-item(class=`${isAbove ? 'is-above' : 'is-below'} track-${point.item.track}${point.planned ? ' is-planned' : ''}`)
                  .research-timeline-half.is-top
                    if isAbove
                      +researchCard(point)
                      span.research-timeline-connector(aria-hidden='true')
                    else
                      time.research-timeline-date(datetime=point.dateStr)= point.dateStr
                  span.research-timeline-dot(aria-hidden='true')
                    span.research-timeline-dot-core
                  .research-timeline-half.is-bottom
                    if isAbove
                      time.research-timeline-date(datetime=point.dateStr)= point.dateStr
                    else
                      span.research-timeline-connector(aria-hidden='true')
                      +researchCard(point)
      else
        p.research-empty= chart.unlimited ? '还没有记录，读完第一篇后它会出现在这里' : '暂无时间线数据'

  script(src=(url_for('/js/research-timeline.js') + '?v=20261027d') defer)
  script(src=(url_for('/js/research-tasks.js') + '?v=20261031b') defer)
