!=partial('includes/page/starlite-hero', { icon: 'flask', sub: 'RESEARCH · PAPERS', motto: '读文献，也记录走过的每一步。' })

#article-container.research-container.container
  - const research = site.data.research || {}
  - const researchPosts = site.posts.filter(post => post.research).sort('-date').toArray()
  - const plans = research.plans || []
  - const linkedPostFor = (posts, title) => posts.find(post => post.title === title)

  - const chartData = plans.map(plan => {
  -   const tracks = plan.tracks || []
  -   const trackLabel = key => (tracks.find(track => track.key === key) || {}).axis_label || ''
  -   const items = (plan.timeline || []).slice().sort((a, b) => {
  -     const dateDiff = new Date(a.date) - new Date(b.date)
  -     return dateDiff || (Number(a.order) || 0) - (Number(b.order) || 0)
  -   }).map(item => {
  -     const linkedPost = linkedPostFor(researchPosts, item.link)
  -     const cover = (linkedPost && linkedPost.cover) || ''
  -     const coverUrl = !cover || /^(https?:)?\/\//.test(cover) || cover[0] === '/' ? cover : '/' + cover
  -     // 与 page-counter 写入 D1 的路径规则一致:去 index.html 与末尾斜杠
  -     const pvPath = linkedPost ? '/' + String(linkedPost.path).replace(/^\/+/, '').replace(/index\.html$/, '').replace(/\/+$/, '') : ''
  -     return { item, href: linkedPost ? url_for(linkedPost.path) : url_for(item.link), title: item.label || (linkedPost ? linkedPost.title : item.title), cover: cover ? url_for(coverUrl) : '', coverFit: linkedPost ? linkedPost.cover_fit : '', trackLabel: trackLabel(item.track), dateStr: date(item.date, 'YYYY-MM-DD'), planned: item.status === 'planned', pvPath }
  -   })
  -   const unlimited = Boolean(plan.unlimited)
  -   const completed = unlimited ? items.length : Number(plan.completed) || 0
  -   const total = unlimited ? 0 : Number(plan.total) || 0
  -   const percent = total ? Math.round((completed / total) * 100) : 0
  -   const planPost = linkedPostFor(researchPosts, plan.plan_link)
  -   const planHref = plan.plan_link ? (String(plan.plan_link).startsWith('/') ? url_for(plan.plan_link) : (planPost ? url_for(planPost.path) : url_for(plan.plan_link))) : ''
  -   const chartPoints = items.map(point => ({ date: point.dateStr, title: point.title, href: point.href, track: point.item.track || '', trackLabel: point.trackLabel }))
  -   return { plan, items, unlimited, completed, total, percent, planPost, planHref, chartPoints }
  - })

  each chart, chartIndex in chartData
    section.research-chart-section(id=`plan-${chart.plan.key}` class=`plan-${chart.plan.key}${chartIndex === 0 ? ' is-active' : ''}` data-plan-section=chart.plan.key role='tabpanel' aria-label=`${chart.plan.title}科研文章`)
      article.research-progress-card
        header.research-progress-header
          .research-task-tabs(role='tablist' aria-label='切换科研任务')
            each task in chartData
              button.research-task-tab(class=`plan-${task.plan.key}${task === chart ? ' is-active' : ''}` type='button' role='tab' data-plan=task.plan.key aria-selected= task === chart ? 'true' : 'false')
                span.research-task-tab-title= task.plan.title
                span.research-task-tab-count= task.unlimited ? `已读 ${task.completed}${task.plan.unit ? ' ' + task.plan.unit : ''}` : `${task.completed}/${task.total}${task.plan.unit ? ' ' + task.plan.unit : ''}`
          if chart.unlimited
            span.research-unlimited-chip 不限量
        if !chart.unlimited
          .research-progress(role='progressbar' aria-valuemin='0' aria-valuemax='100' aria-valuenow=chart.percent aria-label=`${chart.plan.title}进度`)
            span(style=`width: ${chart.percent}%`)
        .research-progress-footer
          span= chart.plan.goal
          if chart.planHref
            a.research-progress-link(href=chart.planHref title=chart.planPost ? chart.planPost.title : chart.plan.title)
              i.fas.fa-list-check
              span 查看规划

      div.research-linechart-card(aria-label=`${chart.plan.title}阅读曲线`)
        header.research-linechart-header
          span.research-linechart-title
            i.fas.fa-chart-line(aria-hidden='true')
            strong 阅读曲线
          if !chart.unlimited
            span.research-linechart-subtitle 累计已读文献
        .research-linechart-body
          script(type='application/json' class='research-linechart-data')!= JSON.stringify({ unlimited: chart.unlimited, total: chart.unlimited ? null : chart.total, tracks: chart.plan.tracks || [], points: chart.chartPoints }).replace(/</g, '\\u003c')

      if chart.items.length
        section.research-card-wall(aria-label=`${chart.plan.title}文章卡片墙`)
          .research-card-grid
            each point in chart.items
              a.research-card(href=point.href title=point.title aria-label=`${point.dateStr} ${point.title}`)
                if point.cover
                  span.research-card-cover
                    img(src=point.cover alt='' loading='lazy' draggable='false' style=point.coverFit === 'contain' ? 'object-fit:contain' : null)
                span.research-card-body
                  span.research-card-title= point.title
                  span.research-card-meta
                    span.research-card-date
                      i.far.fa-calendar-alt(aria-hidden='true')
                      span= point.dateStr
                    if point.trackLabel
                      span.research-card-track(class=`track-${point.item.track}`)= point.trackLabel
                    if point.planned
                      span.research-card-status 规划中
                  if point.item.summary
                    span.research-card-summary= point.item.summary
                span.research-card-foot
                  if point.pvPath
                    span.research-card-pv(data-pv-path=point.pvPath)
                      i.far.fa-eye(aria-hidden='true')
                      span.research-card-pv-text 0 次浏览
                  span.research-card-arrow(aria-hidden='true')
                    i.fas.fa-arrow-right
      else
        p.research-empty= chart.unlimited ? '还没有记录，读完第一篇后它会出现在这里' : '暂无文章数据'

  script(src=(url_for('/js/research-tasks.js') + '?v=20261111b') defer)
