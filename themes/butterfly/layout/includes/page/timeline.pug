#article-container.timeline-container.container
  link(rel='stylesheet' href=(url_for('/css/timeline.css') + '?v=20261026a'))
  -
    const posts = site.posts.sort('-date').toArray()
    const n = posts.length
    const CARD_W = 258
    const CARD_H = 312
    const STEM = 42
    const AMP = 40
    const LANE_H = 840
    const GAP_X = 340
    const EDGE = 220
    const TAIL = 80
    const cols = n === 0 ? 1 : (n <= 6 ? n : (n <= 24 ? 8 : Math.ceil(n / 3)))
    const rows = Math.max(1, Math.ceil(n / cols))
    const stageW = EDGE * 2 + (cols - 1) * GAP_X
    const stageH = rows * LANE_H
    const nodeX = col => EDGE + col * GAP_X
    const nodeY = (row, col) => row * LANE_H + LANE_H / 2 + Math.round(Math.sin(col * 0.9 + row * 1.9) * AMP)
    const stripHtml = html => String(html || '')
      .replace(/<style[\s\S]*?<\/style>/gi, ' ')
      .replace(/<script[\s\S]*?<\/script>/gi, ' ')
      .replace(/<[^>]+>/g, ' ')
      .replace(/&nbsp;/gi, ' ')
      .replace(/&amp;/gi, '&')
      .replace(/&lt;/gi, '<')
      .replace(/&gt;/gi, '>')
      .replace(/&quot;/gi, '"')
      .replace(/&#39;|&apos;/gi, "'")
      .replace(/&[a-z]+;/gi, ' ')
      .replace(/\s+/g, ' ')
      .trim()
    const excerptOf = post => {
      const raw = post.description || post.excerpt || post.content || ''
      const text = stripHtml(raw)
      return text.length > 76 ? text.slice(0, 76) + '…' : text
    }
    const normPath = p => '/' + String(p || '').replace(/^\/+/, '').replace(/index\.html$/, '').replace(/\/+$/, '')
    const firstCat = post => post.categories && post.categories.data && post.categories.data.length ? post.categories.data[0].name : ''
    const fallbackCover = theme.cover && Array.isArray(theme.cover.default_cover) ? theme.cover.default_cover[0] : ''
    let lastYear = null
    const items = posts.map((post, i) => {
      const row = Math.floor(i / cols)
      const col = i % cols
      const x = nodeX(col)
      const y = nodeY(row, col)
      const side = col % 2 === 0 ? 'above' : 'below'
      const year = Number(date(post.date, 'YYYY'))
      const yearStart = year !== lastYear
      if (yearStart) lastYear = year
      return {
        post,
        row,
        col,
        x,
        y,
        side,
        year,
        yearStart,
        href: url_for(post.path),
        pvPath: normPath(post.path),
        cover: post.cover || fallbackCover,
        cat: firstCat(post),
        title: post.title || '无标题',
        excerpt: excerptOf(post),
        dateText: date(post.date, 'YYYY.MM.DD HH:mm'),
        delay: Math.min(i * 45, 720)
      }
    })
    const rowPath = row => {
      const pts = []
      for (let col = 0; col < cols; col++) {
        if (row * cols + col >= n) break
        pts.push({ x: nodeX(col), y: nodeY(row, col) })
      }
      if (!pts.length) return ''
      let d = `M ${pts[0].x - TAIL} ${pts[0].y}`
      for (let k = 1; k < pts.length; k++) {
        const p0 = pts[k - 1]
        const p1 = pts[k]
        const dx = (p1.x - p0.x) * 0.45
        d += ` C ${p0.x + dx} ${p0.y} ${p1.x - dx} ${p1.y} ${p1.x} ${p1.y}`
      }
      d += ` L ${pts[pts.length - 1].x + TAIL} ${pts[pts.length - 1].y}`
      return d
    }
    const paths = []
    for (let row = 0; row < rows; row++) paths.push(rowPath(row))

  header.tl-header
    .tl-header-badge
      i.fas.fa-timeline
    .tl-header-main
      .tl-kicker= (config.author || 'blog') + ' / TIMELINE'
      h1.tl-title= page.title || '归档'
      p.tl-subtitle= page.description || '沿着时间轨迹回看写作记录。'
    .tl-header-meta
      span.tl-meta-vol VOL.01
      span.tl-meta-rule
      span.tl-meta-count= `${n} · POSTS`

  .tl-toolbar
    span.tl-hint
      i.fas.fa-hand-pointer
      span 按住拖动浏览 · 滚轮上下 · Shift+滚轮左右
    a.tl-classic-link(href=url_for('/archives/'))
      i.fas.fa-folder-open
      span 经典归档视图

  if n
    .tl-viewport(style=`height: min(${stageH + 56}px, 78vh)`)
      .tl-stage(style=`width: ${stageW}px; height: ${stageH}px;`)
        svg.tl-wave(width=stageW height=stageH xmlns='http://www.w3.org/2000/svg' aria-hidden='true')
          each d, rowIndex in paths
            if d
              path(class=`tl-wave-line tl-wave-row-${rowIndex % 2}` d=d)
        each it in items
          if it.yearStart
            .tl-year(style=`top: ${it.row * LANE_H + 30}px; animation-delay: ${it.delay}ms`)= it.year
          .tl-stem(class=`is-${it.side}` style=`left: ${it.x - 1}px; top: ${it.side === 'above' ? it.y - STEM : it.y}px; height: ${STEM}px; animation-delay: ${it.delay}ms`)
          .tl-node(class=`is-${it.side}` style=`left: ${it.x - 7}px; top: ${it.y - 7}px; animation-delay: ${it.delay}ms`)
          .tl-node-date(class=`is-${it.side}` style=`left: ${it.x}px; top: ${it.side === 'above' ? it.y + 20 : it.y - 40}px; animation-delay: ${it.delay}ms`)= it.dateText
          a.tl-card(class=`is-${it.side}` href=it.href title=it.title style=`left: ${it.x - CARD_W / 2}px; top: ${it.side === 'above' ? it.y - STEM - CARD_H : it.y + STEM}px; width: ${CARD_W}px; height: ${CARD_H}px; animation-delay: ${it.delay}ms`)
            .tl-card-cover
              img(src=url_for(it.cover) alt=it.title loading='lazy')
              span.tl-card-date
                i.fas.fa-calendar-day
                time(datetime=date_xml(it.post.date))= it.dateText
            .tl-card-body
              if it.cat
                span.tl-card-cat= it.cat
              h3.tl-card-title= it.title
              p.tl-card-desc= it.excerpt
              .tl-card-foot
                span.tl-card-pv(data-pv-path=it.pvPath)
                  i.far.fa-eye
                  span.tl-pv-num 0
                span.tl-card-go
                  i.fas.fa-arrow-right
  else
    p.tl-empty 暂无文章

  script(src=(url_for('/js/timeline.js') + '?v=20261026a') defer)
