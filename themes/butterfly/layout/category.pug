extends includes/layout.pug

block content
  link(rel='stylesheet' href=(url_for('/css/hot-wall.css') + '?v=20261101a'))
  -
    const posts = page.posts.sort('-date').toArray()
    const catName = page.category || _p('page.category')
    const stripHtml = html => String(html || '')
      .replace(/<style[\s\S]*?<\/style>/gi, ' ')
      .replace(/<script[\s\S]*?<\/script>/gi, ' ')
      .replace(/<[^>]+>/g, ' ')
      .replace(/&nbsp;/gi, ' ')
      .replace(/&amp;/gi, '&')
      .replace(/&lt;/gi, '<')
      .replace(/&gt;/gi, '>')
      .replace(/&quot;/gi, '"')
      .replace(/&#39;|&apos;/gi, "'")
      .replace(/&[a-z]+;/gi, ' ')
      .replace(/\s+/g, ' ')
      .trim()
    const excerptOf = post => {
      const raw = post.description || post.excerpt || post.content || ''
      const text = stripHtml(raw)
      return text.length > 88 ? text.slice(0, 88) + '…' : text
    }
    const normPath = p => '/' + String(p || '').replace(/^\/+/, '').replace(/index\.html$/, '').replace(/\/+$/, '')
    const fallbackCover = theme.cover && Array.isArray(theme.cover.default_cover) ? theme.cover.default_cover[0] : ''
    const items = posts.map(post => ({
      href: url_for(post.path),
      pvPath: normPath(post.path),
      cover: post.cover || fallbackCover,
      title: post.title || '无标题',
      excerpt: excerptOf(post),
      dateText: date(post.date, 'YYYY-MM-DD'),
      cat: (post.categories && post.categories.data && post.categories.data[0]) ? post.categories.data[0].name : catName,
    }))

  #category-wall
    .wall-head
      i.fas.fa-folder-open(aria-hidden='true')
      h1= catName
      span.wall-count= `${posts.length} 篇`
    if posts.length
      .hot-grid
        each it in items
          a.hot-card(href=it.href title=it.title)
            .hot-card-cover
              if it.cover
                img(src=url_for(it.cover) alt=it.title loading='lazy' decoding='async' onerror="this.style.display='none'")
              span.hot-cat= it.cat
            .hot-card-body
              .hot-card-title= it.title
              .hot-card-tags
                span.hot-card-date
                  i.far.fa-calendar-alt(aria-hidden='true')
                  = ' ' + it.dateText
              if it.excerpt
                p.hot-card-desc= it.excerpt
              .hot-card-foot
                span.hot-pv(data-pv-path=it.pvPath)
                  i.far.fa-eye(aria-hidden='true')
                  span.hot-pv-num 0 次浏览
                span
                  i.fas.fa-arrow-right(style='transform:rotate(-45deg)')
    else
      .hot-empty 该分类下暂无文章

  script(src=(url_for('/js/category-wall.js') + '?v=20261101a') defer)
